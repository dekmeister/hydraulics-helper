{
  "name": "pumpops",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-prod-bundle.mjs dist",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "preview": "vite preview",
    "test": "vitest run",
    "test:matrix": "VITEST_MATRIX=1 vitest run",
    "sim:trace": "node scripts/sim-trace.mjs",
    "test:e2e": "playwright test",
    "test:e2e:full": "PW_E2E_FULL=1 playwright test",
    "review:baseline": "node scripts/review-baseline.mjs",
    "review": "node scripts/review-baseline.mjs --if-stale && playwright test -c playwright.review.config.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "verify": "npm run lint && npm run test:matrix && npm run build && npm run test:e2e && npm run review"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
